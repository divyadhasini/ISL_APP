import cv2
import mediapipe as mp
import numpy as np
import csv
import os
from datetime import datetime

# --------- FOLDERS ----------
os.makedirs("dataset_frames", exist_ok=True)
os.makedirs("dataset_landmarks", exist_ok=True)

# --------- MEDIAPIPE SETUP ----------
mp_holistic = mp.solutions.holistic
mp_drawing = mp.solutions.drawing_utils

# CSV HEADER BUILDER
def get_header():
    header = ["label"]  # e.g., "hello", "thank you"
    
    # Pose: 33 landmarks → x,y,z,visibility
    for i in range(33):
        header += [f"pose_{i}_x", f"pose_{i}_y", f"pose_{i}_z", f"pose_{i}_v"]

    # Left hand: 21 landmarks
    for i in range(21):
        header += [f"left_{i}_x", f"left_{i}_y", f"left_{i}_z"]

    # Right hand: 21 landmarks
    for i in range(21):
        header += [f"right_{i}_x", f"right_{i}_y", f"right_{i}_z"]

    # Face: 468 landmarks
    for i in range(468):
        header += [f"face_{i}_x", f"face_{i}_y", f"face_{i}_z"]

    return header


# Create CSV file once
csv_path = "dataset_landmarks/isl_dataset.csv"
if not os.path.exists(csv_path):
    with open(csv_path, mode="w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(get_header())


# --------- START CAMERA ----------
cap = cv2.VideoCapture(0)

with mp_holistic.Holistic(
    model_complexity=1,
    min_detection_confidence=0.5,
    min_tracking_confidence=0.5
) as holistic:

    while cap.isOpened():

        ret, frame = cap.read()
        if not ret:
            print("Camera error!")
            break

        image_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        results = holistic.process(image_rgb)
        image_bgr = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2BGR)

        # Draw
        mp_drawing.draw_landmarks(image_bgr, results.pose_landmarks, mp_holistic.POSE_CONNECTIONS)
        mp_drawing.draw_landmarks(image_bgr, results.left_hand_landmarks, mp_holistic.HAND_CONNECTIONS)
        mp_drawing.draw_landmarks(image_bgr, results.right_hand_landmarks, mp_holistic.HAND_CONNECTIONS)
        mp_drawing.draw_landmarks(image_bgr, results.face_landmarks, mp_holistic.FACEMESH_TESSELATION)

        cv2.imshow("ISL Capture (Press S to Save)", image_bgr)

        key = cv2.waitKey(5)

        # ---------------- SAVE DATA ----------------
        if key & 0xFF == ord('s'):
            print("Saving landmark data...")

            # Extract all values in one row
            row = []

            label = input("Enter label for this sample (example: hello): ")
            row.append(label)

            # Pose (33)
            if results.pose_landmarks:
                for lm in results.pose_landmarks.landmark:
                    row += [lm.x, lm.y, lm.z, lm.visibility]
            else:
                row += [0] * (33 * 4)

            # Left hand (21)
            if results.left_hand_landmarks:
                for lm in results.left_hand_landmarks.landmark:
                    row += [lm.x, lm.y, lm.z]
            else:
                row += [0] * (21 * 3)

            # Right hand (21)
            if results.right_hand_landmarks:
                for lm in results.right_hand_landmarks.landmark:
                    row += [lm.x, lm.y, lm.z]
            else:
                row += [0] * (21 * 3)

            # Face (468)
            if results.face_landmarks:
                for lm in results.face_landmarks.landmark:
                    row += [lm.x, lm.y, lm.z]
            else:
                row += [0] * (468 * 3)

            # Write to CSV
            with open(csv_path, mode="a", newline="") as f:
                writer = csv.writer(f)
                writer.writerow(row)

            # Save frame as image
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            cv2.imwrite(f"dataset_frames/{label}_{timestamp}.jpg", frame)

            print("Saved successfully!")

        # Quit
        if key & 0xFF == ord('q'):
            break

cap.release()
cv2.destroyAllWindows()
